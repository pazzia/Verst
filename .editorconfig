root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,kt,kts}]
indent_size = 4

[*.{json,jsonc,yml,yaml,md}]
indent_size = 2

[Makefile]
indent_style = tab

# Licence texts stay byte-for-byte as published (Open Data Commons' plain-text ODbL 1.0 has trailing spaces).
[data/catalogue/LICENSE-ODbL.txt]
trim_trailing_whitespace = false
