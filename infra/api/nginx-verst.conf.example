# verst-api behind a host nginx (docker-compose.host-nginx.yml). The same rules as the Caddyfile:
# private endpoints 404, 2 MB bodies, SSE unbuffered, no access log (URIs carry coordinates, R-07).
#
#   sed "s/__DOMAIN__/212-108-82-26.sslip.io/" nginx-verst.conf.example > /etc/nginx/sites-available/verst
#   ln -s /etc/nginx/sites-available/verst /etc/nginx/sites-enabled/verst && nginx -t && systemctl reload nginx
#   certbot --nginx -d 212-108-82-26.sslip.io      # adds the 443 server and the HTTP → HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    access_log off;
    client_max_body_size 2m;
    server_tokens off;

    location ~ ^/(metrics|readyz|docs|openapi\.json)(/|$) {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # replace, never append: the API trusts this header (entrypoint.sh --forwarded-allow-ips)
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # the plan progress stream (SSE) must reach the phone event by event
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 40s;
        add_header X-Content-Type-Options nosniff always;
    }
}
