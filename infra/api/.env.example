# verst-api on the beta VM (ADR-0020 §7). Copy to `.env` next to docker-compose.yml and fill in.
# Never commit `.env`. Values marked CHANGE are secrets or per-VM settings.

# --- public entry (Caddy) ---
VERST_DOMAIN=api.verst.example            # CHANGE: the DNS name pointing at this VM
VERST_ACME_EMAIL=ops@verst.example        # CHANGE: Let's Encrypt account e-mail

# --- database (compose builds VERST_DATABASE_URL from these) ---
POSTGRES_PASSWORD=                         # CHANGE: openssl rand -hex 32 (hex: it goes into a URL)
VERST_BACKUP_DIR=/srv/verst/backups

# --- verst-api ---
VERST_ENV=prod
VERST_PUBLIC_BASE_URL=https://api.verst.example   # CHANGE: share links are {this}/s/{slug}
VERST_RATE_KEY_SECRET=                     # CHANGE: openssl rand -hex 32 (HMAC key for client IPs)
VERST_WORKERS=2
VERST_LOG_LEVEL=INFO

# Routing (ADR-0017): graphhopper on this VM (compose profile "routing") or the maps VM's private address.
VERST_ROUTING=graphhopper
VERST_GRAPHHOPPER_URL=http://graphhopper:8989
VERST_GRAPHHOPPER_TIMEOUT_S=6
VERST_SYNTHETIC_FALLBACK=false             # true = road model (flagged approxDistances) while GraphHopper is down

# --- trips abroad (CEO 29.10, server only; docs/plan/abroad-wave1-engine.md) ---
# VERST_ABROAD_DIR=/srv/verst/planner/abroad   # default: the image's copy; missing/empty = Russia only
# VERST_RATES_FILE=/srv/verst/rates/rates.json # tools/ci/fetch_rates.py output; unset = money abroad stays local

# Limits (defaults shown; per device unless noted)
VERST_RATE_PLAN_PER_HOUR=30
VERST_RATE_ROUTE_PER_HOUR=60
VERST_RATE_SAVE_PER_HOUR=20
VERST_RATE_FEEDBACK_PER_DAY=10
VERST_RATE_DEFAULT_PER_HOUR=600
VERST_RATE_REGISTER_PER_HOUR_IP=20
VERST_RATE_PUBLIC_PER_HOUR_IP=300
VERST_MAX_SAVED_TRIPS=50
VERST_FEEDBACK_TEXT_DAYS=180
VERST_PLAN_TIMEOUT_S=25

# --- GraphHopper on this VM (profile "routing"; infra/routing/README.md) ---
GH_DATA=/srv/verst/routing
GH_JAVA_OPTS="-Xmx8g -Xms8g"
