<?xml version="1.0" encoding="utf-8"?>
<!--
  Sprint 3 (ADR-0012 §7): HTTPS only (Commons, Nominatim). The one exception is the loopback host, so the e2e
  journey S3-6 can serve Nominatim answers from MockWebServer on the emulator without real traffic. No
  `usesCleartextTraffic` anywhere.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
